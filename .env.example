# Копируйте в .env; заполните два обязательных секрета собственными значениями.
COMPOSE_PROJECT_NAME=racing-local
WEB_BIND=127.0.0.1
WEB_PORT=8080
POSTGRES_USER=racing
POSTGRES_DB=racing
# Для DATABASE_URL используйте пароль из URL-безопасных символов (например secrets.token_hex).
POSTGRES_PASSWORD=
SECRET_KEY=
# true для HTTPS. Для локального HTTP явно задайте false.
SESSION_COOKIE_SECURE=true
# Локально DATABASE_URL не нужен. Пример отдельной демонстрационной БД:
# DATABASE_URL=sqlite:////tmp/racing-demo.db

# Для compose.stage.yaml нужен отдельный env, а не этот локальный шаблон.
# Реальный registry digest из успешного dev build:
# RACING_IMAGE=namespace/racing-club@sha256:...
# STAGE_DATABASE_URL=postgresql+psycopg://...@db:5432/racing_stage_...
# STAGE_DATABASE_NAME=racing_stage_...
# COMPOSE_PROJECT_NAME=racing-club-beta1; WEB_BIND=0.0.0.0; WEB_PORT=8081
# Demo-генератор не читает DATABASE_URL, требует отдельную переменную:
# RACING_DEMO_DATABASE_URL=postgresql+psycopg:///racing_demo_example
